{
  "name": "iampatterson-claudish-proxy",
  "version": "1.0.0",
  "description": "Streaming translation proxy for the Claudish translator: SSE pass-through in front of Claude on Vertex AI with a capacity ladder, per-IP rate limiting, and a hard daily spend cap",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "jest --config jest.config.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@anthropic-ai/vertex-sdk": "^0.19.7",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3"
  }
}
