{
  "displayName": "iampatterson — operations",
  "columns": 12,
  "defaults": {
    "period": "60s",
    "width": 6,
    "height": 4
  },
  "tiles": [
    {
      "title": "Cloud Run request rate per service",
      "series": [
        {
          "legend": "${resource.labels.service_name}",
          "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\"",
          "aligner": "ALIGN_RATE",
          "reducer": "REDUCE_SUM",
          "groupBy": [
            "resource.labels.service_name"
          ]
        }
      ]
    },
    {
      "title": "Cloud Run 95th-percentile latency per service (ms)",
      "series": [
        {
          "legend": "${resource.labels.service_name}",
          "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\"",
          "aligner": "ALIGN_PERCENTILE_95",
          "reducer": "REDUCE_MEAN",
          "groupBy": [
            "resource.labels.service_name"
          ]
        }
      ]
    },
    {
      "title": "Cloud Run 4xx and 5xx responses per service",
      "series": [
        {
          "legend": "${resource.labels.service_name} ${metric.labels.response_code_class}",
          "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND metric.labels.response_code_class=monitoring.regex.full_match(\"[45]xx\")",
          "aligner": "ALIGN_RATE",
          "reducer": "REDUCE_SUM",
          "groupBy": [
            "resource.labels.service_name",
            "metric.labels.response_code_class"
          ]
        }
      ]
    },
    {
      "title": "Pub/Sub throughput: messages published and pushed",
      "series": [
        {
          "legend": "published ${resource.labels.topic_id}",
          "filter": "metric.type=\"pubsub.googleapis.com/topic/send_message_operation_count\" AND resource.type=\"pubsub_topic\"",
          "aligner": "ALIGN_RATE",
          "reducer": "REDUCE_SUM",
          "groupBy": [
            "resource.labels.topic_id"
          ]
        },
        {
          "legend": "pushed ${resource.labels.subscription_id} ${metric.labels.response_class}",
          "filter": "metric.type=\"pubsub.googleapis.com/subscription/push_request_count\" AND resource.type=\"pubsub_subscription\"",
          "aligner": "ALIGN_RATE",
          "reducer": "REDUCE_SUM",
          "groupBy": [
            "resource.labels.subscription_id",
            "metric.labels.response_class"
          ]
        }
      ]
    },
    {
      "title": "Pub/Sub backlog: undelivered messages",
      "series": [
        {
          "legend": "${resource.labels.subscription_id}",
          "filter": "metric.type=\"pubsub.googleapis.com/subscription/num_undelivered_messages\" AND resource.type=\"pubsub_subscription\"",
          "aligner": "ALIGN_MEAN",
          "reducer": "REDUCE_MAX",
          "groupBy": [
            "resource.labels.subscription_id"
          ]
        }
      ]
    },
    {
      "title": "Pub/Sub backlog: oldest unacked message age (s, alert above 300)",
      "series": [
        {
          "legend": "${resource.labels.subscription_id}",
          "filter": "metric.type=\"pubsub.googleapis.com/subscription/oldest_unacked_message_age\" AND resource.type=\"pubsub_subscription\"",
          "aligner": "ALIGN_MAX",
          "reducer": "REDUCE_MAX",
          "groupBy": [
            "resource.labels.subscription_id"
          ]
        }
      ]
    },
    {
      "title": "BigQuery slots allocated to the project",
      "series": [
        {
          "legend": "slots",
          "filter": "metric.type=\"bigquery.googleapis.com/slots/allocated_for_project\" AND resource.type=\"global\"",
          "aligner": "ALIGN_MEAN",
          "reducer": "REDUCE_MEAN"
        }
      ]
    },
    {
      "title": "BigQuery billed scan per day (bytes; on-demand is $6.25 per TiB, so 1 TiB/day ≈ $6)",
      "series": [
        {
          "legend": "${metric.labels.priority}",
          "filter": "metric.type=\"bigquery.googleapis.com/query/scanned_bytes_billed\" AND resource.type=\"global\"",
          "aligner": "ALIGN_DELTA",
          "reducer": "REDUCE_SUM",
          "groupBy": [
            "metric.labels.priority"
          ],
          "period": "86400s"
        }
      ]
    },
    {
      "title": "TLS certificate days to expiry per host (alert below 14)",
      "series": [
        {
          "legend": "${resource.labels.host}",
          "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/time_until_ssl_cert_expires\" AND resource.type=\"uptime_url\"",
          "aligner": "ALIGN_MEAN",
          "reducer": "REDUCE_MEAN",
          "groupBy": [
            "resource.labels.host"
          ],
          "period": "1200s"
        }
      ]
    },
    {
      "title": "Claudish proxy budget threshold crossings (50/80/100 % of the daily cap)",
      "series": [
        {
          "legend": "${metric.labels.pct} %",
          "filter": "metric.type=\"logging.googleapis.com/user/claudish_proxy_events\" AND resource.type=\"cloud_run_revision\" AND metric.labels.event=\"budget_threshold\"",
          "aligner": "ALIGN_DELTA",
          "reducer": "REDUCE_SUM",
          "groupBy": [
            "metric.labels.pct"
          ],
          "period": "300s"
        }
      ]
    },
    {
      "title": "Cloud Scheduler failures — the execution log for the three data-generator jobs (empty is the healthy state)",
      "width": 12,
      "logs": "resource.type=\"cloud_scheduler_job\" AND severity>=ERROR"
    }
  ]
}
