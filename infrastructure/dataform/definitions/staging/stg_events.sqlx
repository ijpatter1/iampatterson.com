config {
  type: "table",
  schema: "iampatterson_staging",
  description: "Deduplicated, typed, and standardized events from the raw event stream. Converts timestamps, extracts UTM parameters, and adds business model classification.",
  columns: {
    event_id: "Synthetic unique event identifier (SHA256 of key fields)",
    event_name: "Snake_case event name",
    event_timestamp: "Event timestamp as TIMESTAMP (from client-side ISO string or server received_timestamp)",
    received_at: "Server-side timestamp when sGTM processed the event",
    session_id: "Resolved session key: COALESCE(iap_session_id, session_id). The raw session_id is reserved in gtag.js and is NULL on every real-browser row.",
    client_id: "GA4 client ID",
    business_model: "Derived business model: ecommerce, subscription, leadgen, or consulting",
    page_location: "Full page URL",
    page_path: "URL pathname",
    page_title: "Document title",
    page_referrer: "Full referrer URL",
    utm_source: "Traffic source (google, facebook, tiktok, email, etc.)",
    utm_medium: "Traffic medium (cpc, paid_social, email, organic, etc.)",
    utm_campaign: "Raw campaign name (may contain inconsistent naming)",
    is_synthetic: "Whether the event was generated by the background data generator"
  },
  bigquery: {
    partitionBy: "DATE(event_timestamp)",
    clusterBy: ["business_model", "event_name", "session_id"]
  }
}

js {
  const { url_decode } = require("includes/url_decode");
}

WITH raw_events AS (
  SELECT
    *,
    -- `session_id` is reserved in gtag.js, which treats it as a configuration
    -- field and consumes it before the hit is built, so `ep.session_id` never
    -- leaves the page and every row from a real browser arrives with it NULL.
    -- The generator is not exempt because it skips the GA4 client — it posts to
    -- the same /g/collect endpoint with the same v=2 protocol — but because it
    -- hand-builds the query string and sets ep.session_id explicitly
    -- (data-generator/src/transport.ts).
    -- `iap_session_id` was added in 2026-03 precisely because GA4 will not
    -- remap it. Partitioning on the raw column groups every real event under
    -- NULL, so ROW_NUMBER collapses unrelated visitors into one partition and
    -- the dedup filter discards them.
    ROW_NUMBER() OVER (
      PARTITION BY event_name, COALESCE(iap_session_id, session_id), received_timestamp, page_path
      ORDER BY page_path, COALESCE(timestamp, '')
    ) AS _row_num
  FROM
    ${ref("iampatterson_raw", "events_raw")}
)

SELECT
  -- Synthetic event ID for deduplication tracking
  TO_HEX(SHA256(CONCAT(
    COALESCE(event_name, ''), '|',
    COALESCE(iap_session_id, session_id, ''), '|',
    CAST(received_timestamp AS STRING), '|',
    COALESCE(page_path, '')
  ))) AS event_id,

  event_name,

  -- Prefer client-side timestamp (ISO 8601), fall back to server received_timestamp
  COALESCE(
    SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', timestamp),
    SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*SZ', timestamp),
    TIMESTAMP_MILLIS(received_timestamp)
  ) AS event_timestamp,

  TIMESTAMP_MILLIS(received_timestamp) AS received_at,

  -- The resolved session key. Downstream models and every mart read this as
  -- `session_id`, so the repair lands once here rather than in each of them.
  --
  -- `iap_session_id` FIRST, matching pubsub-tag-template.js:54, which resolves
  -- iap_session_id || ga_session_id || cookie and never consults `session_id`
  -- because that is the field GA4 rewrites. Preferring it here means the
  -- warehouse and the real-time overlay key the same visitor identically by
  -- construction, rather than by the accident that GA4 currently leaves
  -- `session_id` empty.
  COALESCE(iap_session_id, session_id) AS session_id,
  client_id,

  -- Derive business model from page path
  CASE
    WHEN page_path LIKE '/demo/ecommerce%' THEN 'ecommerce'
    WHEN page_path LIKE '/demo/subscription%' THEN 'subscription'
    WHEN page_path LIKE '/demo/leadgen%' THEN 'leadgen'
    ELSE 'consulting'
  END AS business_model,

  page_location,
  page_path,
  ${url_decode("page_title")} AS page_title,
  page_referrer,

  -- UTM / attribution
  ${url_decode("utm_source")} AS utm_source,
  ${url_decode("utm_medium")} AS utm_medium,
  ${url_decode("utm_campaign")} AS utm_campaign,

  -- Consent state
  consent_analytics,
  consent_marketing,
  consent_preferences,

  -- Generator traffic, and only generator traffic.
  --
  -- This read `iap_source = 'true'`, which the real site sends as well: that
  -- marker separates our instrumented events from GA4's own enhanced-measurement
  -- hits, a different question from the one this column's name asks. Every real
  -- visitor was therefore labelled synthetic. Unobservable until the session key
  -- was resolved, because no real session reached stg_sessions to be mislabelled.
  --
  -- `iap_synthetic` is sent only by the generator (data-generator/src/transport.ts).
  -- It appears only on rows written after that deploy, so the user agent — which
  -- the generator has always set — labels the rest of the 60-day raw window.
  COALESCE(
    iap_synthetic = 'true',
    user_agent = 'iampatterson-data-generator/1.0',
    FALSE
  ) AS is_synthetic,

  -- E-commerce fields
  product_id,
  ${url_decode("product_name")} AS product_name,
  product_price,
  ${url_decode("product_category")} AS product_category,
  quantity,
  cart_total,
  item_count,
  order_id,
  order_total,
  ${url_decode("products")} AS products,

  -- Subscription fields
  plan_id,
  ${url_decode("plan_name")} AS plan_name,
  plan_price,
  renewal_month,
  revenue,
  tenure_months,
  reason AS churn_reason,

  -- Lead gen fields
  form_name,
  field_name,
  form_success,
  partnership_type,
  budget_range,
  ${url_decode("company_name")} AS company_name,
  lead_id,
  qualification_tier,

  -- Interaction fields
  depth_percentage,
  depth_pixels,
  link_text,
  link_url,
  cta_text,
  cta_location

FROM raw_events
WHERE _row_num = 1
