{
  "name": "iampatterson-data-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Run service that generates synthetic events for three demo business models, feeding sGTM and BigQuery",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "jest --config jest.config.json",
    "test:watch": "jest --config jest.config.json --watch",
    "test:coverage": "jest --config jest.config.json --coverage"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1",
    "express": "^4.18.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.0",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
