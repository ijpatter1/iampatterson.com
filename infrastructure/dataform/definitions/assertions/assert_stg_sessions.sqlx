config {
  type: "assertion",
  description: "Validates stg_sessions: session_start present and <= session_end, non-negative duration, and that real (non-synthetic) sessions are present at all."
}

/*
 * Rewritten 2026-09-08.
 *
 * The previous version selected rows `WHERE session_id IS NULL` from
 * stg_sessions — a model whose own WHERE clause removes exactly those rows. It
 * could never return one. It reported green for months while the table held
 * 193,323 sessions of which zero were real, because `session_id` is a reserved
 * GA4 parameter name that the GA4 client in sGTM consumes, leaving every
 * browser row NULL and dropping every real visitor at that filter.
 *
 * An assertion that cannot fail is worse than no assertion: it occupies the
 * place where a real check would have gone. The null check is dropped outright
 * rather than relocated — stg_sessions filters those rows itself, so there is
 * nowhere in this assertion it could still bite — and the check that would
 * have caught the actual fault is added in its place.
 */

WITH quality AS (
  SELECT
    session_id,
    session_start,
    session_end,
    session_duration_seconds,
    'row_quality' AS failure
  FROM ${ref("stg_sessions")}
  WHERE
    -- No `session_id IS NULL` clause: stg_sessions filters those rows out
    -- itself, so asserting their absence here can never fail. That was the
    -- whole of the previous assertion.
    session_start IS NULL
    OR session_start > session_end
    OR session_duration_seconds < 0
),

/*
 * The fault this assertion exists for. Real traffic is low-volume next to the
 * generator, so an aggregate null-rate check would not have moved; the only
 * signal that distinguishes "the warehouse describes visitors" from "the
 * warehouse describes the generator" is whether any non-synthetic session
 * survives the pipeline at all.
 *
 * Scoped to 30 days, not 7. The failure condition here is visitor volume on a
 * low-traffic consulting site, and this project has already paid for that
 * mistake once: docs/runbook/dataform-assertion-failure.md records
 * assert_volume_anomaly failing every night for a month because its window did
 * not tolerate a legitimate idle period. A quiet week is ordinary; a quiet
 * month on a site with any inbound at all is a fault. [14.1] also gates 21 of
 * 22 GA4 tags on analytics_storage, so declining visitors now produce no
 * events, which shrinks the pool this assertion draws from.
 */
real_sessions_present AS (
  SELECT
    CAST(NULL AS STRING) AS session_id,
    CAST(NULL AS TIMESTAMP) AS session_start,
    CAST(NULL AS TIMESTAMP) AS session_end,
    CAST(NULL AS INT64) AS session_duration_seconds,
    'no_real_sessions_in_30d' AS failure
  FROM (SELECT 1)
  WHERE NOT EXISTS (
    SELECT 1
    FROM ${ref("stg_sessions")}
    WHERE is_synthetic = FALSE
      AND session_start >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 DAY)
  )
)

SELECT * FROM quality
UNION ALL
SELECT * FROM real_sessions_present
