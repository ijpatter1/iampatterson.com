{
  "name": "iampatterson-data-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Run service that generates synthetic events for three demo business models, feeding sGTM and BigQuery",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "jest --config jest.config.json",
    "test:watch": "jest --config jest.config.json --watch",
    "test:coverage": "jest --config jest.config.json --coverage"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.0.3",
    "express": "^5.2.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
